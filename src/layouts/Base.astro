---
const {title,description,canonical,jsonld}=Astro.props;
const analytics=import.meta.env.PUBLIC_GA_ID;
---
<!doctype html><html lang="es-CO"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Radar IA Latam</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;800&family=Source+Serif+4:wght@400;700&display=swap" rel="stylesheet"/><script type="application/ld+json" set:html={JSON.stringify(jsonld)}/>{analytics && <><script async src={`https://www.googletagmanager.com/gtag/js?id=${analytics}`}></script><script is:inline define:vars={{analytics}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',analytics);</script></>}</head><body><a class="skip" href="#contenido">Saltar al contenido</a><div class="shell"><header><a class="brand" href="/">Radar <span>IA</span> Latam</a><nav aria-label="Navegación principal"><a href="/">Inicio</a><a href="/acerca/">Acerca de</a></nav></header><main id="contenido"><slot/></main><footer><strong>Radar IA Latam</strong><div><p>Información basada en fuentes oficiales. Verifica condiciones y disponibilidad antes de usar una oferta.</p><p>Sin afiliados ni anuncios por ahora. <a href="/acerca/">Política editorial</a></p></div></footer></div></body></html>
<style is:global>
/* Hallmark · v2.0.0 · redesign: full · theme: Editorial · signature: índice de novedades */
/* Critique: repeated rounded cards replaced with an editorial reading index. */
:root{--paper:#f7f5ed;--ink:#191c1c;--ink-2:#343938;--muted:#626762;--rule:#c6c6ba;--accent:#176b48;--focus:#176b48;--font-display:"Bricolage Grotesque",Arial,sans-serif;--font-body:"Source Serif 4",Georgia,serif}*{box-sizing:border-box}html,body{margin:0;overflow-x:clip}body{background:var(--paper);color:var(--ink-2);font:18px/1.55 var(--font-body)}.shell{max-width:1240px;margin:auto;padding:0 clamp(18px,4vw,64px)}a{color:inherit;text-decoration-color:var(--muted);text-underline-offset:.18em}a:hover{color:var(--accent);text-decoration-color:var(--accent)}a:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.skip{position:absolute;left:-9999px;top:12px;background:var(--paper);padding:8px;z-index:10}.skip:focus{left:12px}header{border-bottom:4px solid var(--ink);min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand,footer strong{font:800 clamp(1.55rem,3vw,2.4rem)/1 var(--font-display);font-variation-settings:"wdth" 75,"opsz" 96;text-decoration:none;color:var(--ink)}.brand span{color:var(--accent)}nav{display:flex;gap:clamp(14px,3vw,36px)}nav a{font:500 1rem var(--font-display);text-decoration:none}main{min-height:60vh}h1,h2,h3{font-family:var(--font-display);font-weight:800;font-variation-settings:"wdth" 75,"opsz" 96;color:var(--ink);line-height:1;overflow-wrap:break-word;min-width:0}h1{font-size:clamp(3.5rem,9vw,8.5rem);letter-spacing:-.025em;margin:.15em 0 .25em}h2{font-size:clamp(2rem,4vw,3.5rem)}h3{font-size:1.6rem}p,li{max-width:72ch}.meta{font:500 .9rem/1.4 var(--font-display);color:var(--muted)}footer{border-top:4px solid var(--ink);display:grid;grid-template-columns:1fr 1fr;gap:36px;padding:36px 0 60px;font-size:.85rem}footer p{margin:0 0 12px}article.prose{max-width:820px;margin:42px auto 90px}article.prose h1{font-size:clamp(3rem,7vw,6rem)}article.prose .standfirst{font-size:clamp(1.35rem,2.6vw,2rem);line-height:1.35}article.prose hr{border:0;border-top:1px solid var(--rule);margin-top:40px}article.prose a{overflow-wrap:anywhere}@media(max-width:650px){header{min-height:75px;align-items:flex-start;padding:16px 0;flex-direction:column;gap:12px}.brand{font-size:1.85rem}footer{grid-template-columns:1fr;gap:20px}}
</style>
