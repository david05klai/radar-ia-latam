---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('posts')).sort((a,b)=>b.data.pubDate.getTime()-a.data.pubDate.getTime());
const canonical=new URL('/',Astro.site).href;
---
<Base title="Herramientas de IA gratuitas para Colombia y Latinoamérica" description="Guías y novedades de herramientas de IA con fuentes oficiales, fechas verificadas y límites claros." canonical={canonical} jsonld={{'@context':'https://schema.org','@type':'WebSite',name:'Radar IA Latam',url:canonical,inLanguage:'es-CO'}}><section class="hero"><div><h1>IA útil, con fuentes y sin humo</h1><p>Herramientas gratuitas y novedades relevantes para Colombia y Latinoamérica. Indicamos qué se puede comprobar y cuándo se verificó.</p><a class="hero-link" href="#publicaciones">Leer publicaciones</a></div><aside><strong>Una lectura más clara de la IA</strong><span>Guías y novedades documentadas, con fecha y enlace a la fuente original.</span></aside></section><section id="publicaciones" class="contents"><div class="section-head"><h2>Publicaciones</h2><p>El índice</p></div>{posts.map(post=><article class="index-row"><div class="row-meta"><span>{post.data.kind==='guia'?'Guía':'Novedad'}</span><time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('es-CO',{timeZone:'UTC'})}</time></div><div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p></div></article>)}</section></Base>
<style>.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,.36fr);gap:clamp(28px,6vw,90px);min-height:580px;align-items:end;padding:55px 0 65px}.hero p{font-size:clamp(1.35rem,2.3vw,1.85rem);line-height:1.32;max-width:690px;margin:0 0 32px}.hero-link{display:inline-block;background:var(--ink);color:var(--paper);font:500 1rem var(--font-display);text-decoration:none;padding:15px 24px;min-height:50px}.hero-link:hover{background:var(--accent);color:var(--paper)}aside{border-top:1px solid var(--ink);padding:15px 0 0;display:grid;gap:12px;align-self:end;font-size:1rem}aside strong{font:800 1.45rem/1.05 var(--font-display);font-variation-settings:"wdth" 75}.contents{border-top:4px solid var(--ink);padding-bottom:110px}.section-head{display:flex;justify-content:space-between;align-items:baseline;gap:20px}.section-head h2{margin:18px 0 28px}.section-head p{font:500 .9rem var(--font-display)}.index-row{border-top:1px solid var(--rule);display:grid;grid-template-columns:180px 1fr;gap:clamp(20px,4vw,60px);padding:26px 0 33px}.row-meta{font:500 .9rem/1.5 var(--font-display);display:flex;flex-direction:column;gap:5px;color:var(--muted)}.index-row h3{font-size:clamp(2rem,3.5vw,3.35rem);margin:0 0 10px}.index-row h3 a{text-decoration:none}.index-row p{margin:0;max-width:760px}@media(max-width:750px){.hero{grid-template-columns:1fr;min-height:auto;padding:45px 0 55px}aside{max-width:420px}.index-row{grid-template-columns:1fr;gap:10px}.row-meta{flex-direction:row;gap:16px}}@media(max-width:400px){.hero h1{font-size:3.25rem}}</style>
